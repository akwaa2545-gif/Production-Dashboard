{
  "name": "onemes-quantity-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "deploy:portable": "deploy-portable.cmd",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "mssql": "^11.0.1"
  },
  "vitest": {
    "coverage": {
      "provider": "v8",
      "include": [
        "src/app.js",
        "src/config.js",
        "src/sqlRepository.js"
      ],
      "thresholds": {
        "lines": 80,
        "functions": 80,
        "statements": 80,
        "branches": 75
      }
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
