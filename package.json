{
  "name": "onemes-quantity-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "refresh:901-staging": "node src/refresh901Staging.js",
    "refresh:wip-staging": "node src/refreshWipStaging.js",
    "refresh:ta-yield-staging": "node src/refreshTaYieldStaging.js",
    "refresh:ta-yield-staging-history": "node src/refreshTaYieldStaging.js --history",
    "migrate:ta-yield-monthly-summary": "node scripts/migrate-ta-yield-monthly-summary.mjs",
    "migrate:ta-yield-machine-rows": "node scripts/migrate-ta-yield-machine-rows.mjs",
    "migrate:staging-indexes": "node scripts/migrate-staging-indexes.mjs",
    "validate:staging": "node src/validateStaging.js",
    "migrate:ta-yield-actions": "node scripts/migrate-ta-yield-actions.mjs",
    "import:ta-yield-actions": "node scripts/import-ta-yield-actions.mjs",
    "migrate:ta-yield-targets": "node scripts/migrate-ta-yield-targets.mjs",
    "import:ta-yield-cy26-targets": "node scripts/import-ta-yield-cy26-targets.mjs",
    "import:ta-yield-cy26-group-targets": "node scripts/import-ta-yield-cy26-group-targets.mjs",
    "deploy:portable": "deploy-portable.cmd",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/identity-cache-persistence": "^1.3.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "mssql": "^11.0.1"
  },
  "vitest": {
    "coverage": {
      "provider": "v8",
      "include": [
        "src/app.js",
        "src/config.js",
        "src/sqlRepository.js"
      ],
      "thresholds": {
        "lines": 80,
        "functions": 80,
        "statements": 80,
        "branches": 75
      }
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
