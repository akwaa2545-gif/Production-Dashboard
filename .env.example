# Azure SQL Database connection (backend only)
SQL_SERVER=apaz-sqlinstprod3.d9dee625aa38.database.windows.net
SQL_DATABASE=OneMES_Report_THR
DB_AUTH=ActiveDirectoryInteractive
APP_URL=http://localhost:3000/
AZURE_TENANT_ID=
# Configure each dashboard data source independently.
CLOSED_DB_VIEW=PowerBIThailand.ClosedBatch_v
CLOSED_DATE_COLUMN=CloseDate
CLOSED_PROCESS_COLUMN=ProdType
CLOSED_SERIE_COLUMN=Series
CLOSED_CASE_COLUMN=
CLOSED_PN_COLUMN=PartNumber
CLOSED_GROUP_COLUMN=Series
CLOSED_QUANTITY_COLUMN=CompleteQty
CLOSED_SERIE_BLANK_PRODUCT=SC
CLOSED_SERIE_BLANK_VALUE=Element
CLOSED_SERIE_BLANK_SOURCE_PRODUCT=NEO
CLOSED_SERIE_BLANK_SOURCE_COLUMN=ProdLine
CLOSED_SERIE_BLANK_SOURCE_FORMAT=neo-capacitor

LOT_DB_VIEW=PowerBIThailand.LotCompleteLog
LOT_DATE_COLUMN=OccuredOn
LOT_PROCESS_COLUMN=To_OperationName
LOT_SERIE_COLUMN=Series
LOT_SERIE_LOOKUP_VIEW=PowerBIThailand.ClosedBatch_v
LOT_SERIE_SOURCE_JOIN_COLUMN=JobName
LOT_SERIE_LOOKUP_JOIN_COLUMN=JobName
LOT_PRODUCT_LOOKUP_COLUMN=ProdType
LOT_CASE_COLUMN=
LOT_PN_COLUMN=From_ItemName
LOT_GROUP_COLUMN=Series
LOT_QUANTITY_COLUMN=QuantityMoved
LOT_SERIE_BLANK_PRODUCT=SC
LOT_SERIE_BLANK_VALUE=Element
LOT_SERIE_BLANK_SOURCE_PRODUCT=NEO
LOT_SERIE_BLANK_SOURCE_COLUMN=ProdLine
LOT_SERIE_BLANK_SOURCE_FORMAT=neo-capacitor
LOT_DISPOSITION_COLUMN=DispositionType
LOT_DISPOSITION_VALUE=good
LOT_CHART_COLUMN=From_OperationName
LOT_CHART_EXCLUDED_VALUES=RouteDecisionPoint

# Leave false  accepting the server certificate.
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_REQUEST_TIMEOUT=0
PORT=3000
HOST=0.0.0.0

# Optional shared MTD target storage.
SETTINGS_SQL_SERVER=svr120a
SETTINGS_SQL_DATABASE=Measuring_DB
SETTINGS_SQL_USER=msdb
SETTINGS_SQL_PASSWORD=replace-with-settings-database-password
SETTINGS_SQL_TABLE=dbo.DashboardMtdTarget
SETTINGS_SQL_TRUST_SERVER_CERTIFICATE=true

# Optional fast local staging store for 901. Keep this password only in .env.
DASHBOARD_901_STAGING_ENABLED=false
STAGING_SQL_SERVER=svr120a
STAGING_SQL_DATABASE=ProdMESIT
STAGING_SQL_USER=ProdMESIT
STAGING_SQL_PASSWORD=replace-with-staging-database-password
STAGING_SQL_TRUST_SERVER_CERTIFICATE=true
STAGING_901_SQL_TABLE=dbo.Dashboard901Daily
